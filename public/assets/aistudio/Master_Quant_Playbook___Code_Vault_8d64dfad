@mcp.tool()
async def evaluate_btc_lead_lag(
    coinbase_spot: float,
    strike: float,
    minutes_left: float,
    yes_ask: float,
    no_ask: float,
    annual_vol: float = 0.55,
    fee_per_contract: float = 0.02,
) -> Dict[str, Any]:
    """Asynchronously calculates Black-Scholes binary probability & enforces the [$0.45, $0.82] fee gate."""
    await asyncio.sleep(0.005)
    if coinbase_spot <= 0 or strike <= 0 or minutes_left <= 0 or annual_vol <= 0:
        return {
            "action": "HOLD",
            "contracts": 0,
            "fairYesProb": 0.5,
            "netEdgePerContract": 0.0,
            "dataQualityWarning": True,
            "rationale": "Data quality warning: invalid spot, strike, volatility, or expiry. Defaulting to HOLD.",
        }

    t_years = max(minutes_left, 0.1) / (365.25 * 24 * 60)
    sigma_t = annual_vol * math.sqrt(t_years)
    d2 = (math.log(coinbase_spot / strike) - 0.5 * (annual_vol ** 2) * t_years) / sigma_t
    fair_yes = 0.5 * (1.0 + math.erf(d2 / math.sqrt(2.0)))
    fair_no = 1.0 - fair_yes

    yes_edge = fair_yes - (yes_ask + fee_per_contract)
    no_edge = fair_no - (no_ask + fee_per_contract)

    best_side = "BUY_YES" if yes_edge >= no_edge else "BUY_NO"
    best_ask = yes_ask if best_side == "BUY_YES" else no_ask
    best_edge = max(yes_edge, no_edge)

    if best_ask < 0.45 or best_ask > 0.82:
        return {
            "action": "HOLD",
            "contracts": 0,
            "fairYesProb": round(fair_yes, 4),
            "netEdgePerContract": round(best_edge, 4),
            "feeGatePassed": False,
            "dataQualityWarning": False,
            "rationale": f"Blocked by Fee Gate: Ask ${best_ask:.2f} outside [$0.45, $0.82]",
        }
    if best_edge < 0.04:
        return {
            "action": "HOLD",
            "contracts": 0,
            "fairYesProb": round(fair_yes, 4),
            "netEdgePerContract": round(best_edge, 4),
            "feeGatePassed": True,
            "dataQualityWarning": False,
            "rationale": f"Insufficient Net Edge (${best_edge:.3f} < $0.04 min)",
        }

    contracts = min(25, int(18.00 // (best_ask + fee_per_contract)))
    return {
        "action": best_side,
        "contracts": contracts,
        "fairYesProb": round(fair_yes, 4),
        "netEdgePerContract": round(best_edge, 4),
        "feeGatePassed": True,
        "dataQualityWarning": False,
        "rationale": f"Approved {best_side}: Net Edge +${best_edge:.3f}/contract ({contracts} contracts)",
    }


