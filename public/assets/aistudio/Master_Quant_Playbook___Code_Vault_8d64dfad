@mcp.tool()
async def route_to_dlq(
    idempotency_key: str,
    failed_tool: str,
    payload_json: str,
    error_reason: str,
    severity: str = "CRITICAL",
) -> Dict[str, Any]:
    """Fallback Dead-Letter Queue tool: persists failed or rejected mutating calls into DuckDB."""
    await asyncio.sleep(0.005)
    con = init_db()
    try:
        replay = check_idempotent_replay(con, idempotency_key)
        if replay:
            return replay

        dlq_id = f"dlq-{hashlib.sha256(idempotency_key.encode('utf-8')).hexdigest()[:10]}"
        now_utc = datetime.datetime.now(datetime.timezone.utc)
        con.execute(
            "INSERT OR REPLACE INTO dead_letter_queue VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
            [dlq_id, idempotency_key, failed_tool, payload_json, error_reason, severity.upper(), "QUARANTINED_HOLD", now_utc],
        )
        res = {
            "dlqId": dlq_id,
            "idempotencyKey": idempotency_key,
            "failedTool": failed_tool,
            "severity": severity.upper(),
            "status": "QUARANTINED_HOLD",
            "idempotentReplay": False,
            "dataQualityWarning": True,
            "rationale": f"Quarantined {failed_tool} in DLQ ({dlq_id}) due to '{error_reason[:48]}'; posture locked to HOLD.",
        }
        save_idempotent_result(con, idempotency_key, "route_to_dlq", {"failed_tool": failed_tool}, res)
        return res
    finally:
        con.close()


