rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lakeskyler904@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: QuantAgentState
    function isValidQuantAgentState(data) {
      return data.keys().hasAll([
        'id',
        'ownerUid',
        'name',
        'targetSymbol',
        'status',
        'allocatedCapitalUsd',
        'kalshiAllocatedUsd',
        'publicAllocatedUsd',
        'predictionMarketDataSource',
        'sharpe',
        'winRate',
        'totalPnlUsd',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerUid',
        'name',
        'targetSymbol',
        'status',
        'allocatedCapitalUsd',
        'kalshiAllocatedUsd',
        'publicAllocatedUsd',
        'predictionMarketDataSource',
        'sharpe',
        'winRate',
        'totalPnlUsd',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerUid == request.auth.uid &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
      data.targetSymbol is string && data.targetSymbol.size() >= 1 && data.targetSymbol.size() <= 32 &&
      data.status is string && data.status in ['ACTIVE', 'PAUSED', 'KILLED_BY_RISK', 'HALTED_BY_KILL_SWITCH'] &&
      data.allocatedCapitalUsd is number && data.allocatedCapitalUsd >= 0 && data.allocatedCapitalUsd <= 1000000 &&
      data.kalshiAllocatedUsd is number && data.kalshiAllocatedUsd >= 0 && data.kalshiAllocatedUsd <= 1000000 &&
      data.publicAllocatedUsd is number && data.publicAllocatedUsd >= 0 && data.publicAllocatedUsd <= 1000000 &&
      data.predictionMarketDataSource is string && data.predictionMarketDataSource.size() >= 1 && data.predictionMarketDataSource.size() <= 64 &&
      data.sharpe is number &&
      data.winRate is number && data.winRate >= 0 && data.winRate <= 100 &&
      data.totalPnlUsd is number &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: QuantVaultCheckpoint
    function isValidQuantVaultCheckpoint(data) {
      return data.keys().hasAll([
        'checkpointId',
        'ownerUid',
        'topAgentId',
        'topAgentAllocatedUsd',
        'kalshiDirectUsd',
        'publicEventContractUsd',
        'combinedEquityUsd',
        'duckDbTotalRows',
        'duckDbSettledRows',
        'calibratedBrierScore',
        'activeMetaModelId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'checkpointId',
        'ownerUid',
        'topAgentId',
        'topAgentAllocatedUsd',
        'kalshiDirectUsd',
        'publicEventContractUsd',
        'combinedEquityUsd',
        'duckDbTotalRows',
        'duckDbSettledRows',
        'calibratedBrierScore',
        'activeMetaModelId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.checkpointId is string && data.checkpointId.size() >= 1 && data.checkpointId.size() <= 128 && data.checkpointId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerUid == request.auth.uid &&
      data.topAgentId is string && data.topAgentId.size() >= 1 && data.topAgentId.size() <= 128 &&
      data.topAgentAllocatedUsd is number && data.topAgentAllocatedUsd >= 0 && data.topAgentAllocatedUsd <= 1000000 &&
      data.kalshiDirectUsd is number && data.kalshiDirectUsd >= 0 && data.kalshiDirectUsd <= 1000000 &&
      data.publicEventContractUsd is number && data.publicEventContractUsd >= 0 && data.publicEventContractUsd <= 1000000 &&
      data.combinedEquityUsd is number && data.combinedEquityUsd >= 0 &&
      data.duckDbTotalRows is number && data.duckDbTotalRows >= 0 &&
      data.duckDbSettledRows is number && data.duckDbSettledRows >= 0 &&
      data.calibratedBrierScore is number && data.calibratedBrierScore >= 0 && data.calibratedBrierScore <= 1 &&
      data.activeMetaModelId is string && data.activeMetaModelId.size() >= 1 && data.activeMetaModelId.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /quant_agents/{agentId} {
      allow get: if isSignedIn() && isValidId(agentId) && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(agentId) &&
        isValidQuantAgentState(incoming()) &&
        incoming().id == agentId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(agentId) &&
        isValidQuantAgentState(incoming()) &&
        (existing().ownerUid == request.auth.uid || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'targetSymbol',
            'status',
            'allocatedCapitalUsd',
            'kalshiAllocatedUsd',
            'publicAllocatedUsd',
            'predictionMarketDataSource',
            'sharpe',
            'winRate',
            'totalPnlUsd',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(agentId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /quant_vault_checkpoints/{checkpointId} {
      allow get: if isSignedIn() && isValidId(checkpointId) && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(checkpointId) &&
        isValidQuantVaultCheckpoint(incoming()) &&
        incoming().checkpointId == checkpointId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(checkpointId) &&
        isValidQuantVaultCheckpoint(incoming()) &&
        (existing().ownerUid == request.auth.uid || isAdmin()) &&
        incoming().checkpointId == existing().checkpointId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'topAgentId',
            'topAgentAllocatedUsd',
            'kalshiDirectUsd',
            'publicEventContractUsd',
            'combinedEquityUsd',
            'duckDbTotalRows',
            'duckDbSettledRows',
            'calibratedBrierScore',
            'activeMetaModelId',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(checkpointId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }
  }
}
