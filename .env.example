# ============================================================================
# Finesse_finance / TradePulse AI — Environment Configuration Template
# Never commit real API keys, private keys, or bearer tokens to version control.
# ============================================================================

# --- 1. Gemini AI (Server-Side Only) ---
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
KALSHI_GEMINI_MODEL="gemini-3-flash-preview"

# --- 2. Application & Firebase Admin Configuration ---
APP_URL="MY_APP_URL"
FIREBASE_PROJECT_ID="gen-lang-client-0057136781"
FIRESTORE_DATABASE_ID="ai-studio-tradepulseai-5afcfb28-f923-42f2-a189-b764775d8ca2"

# --- 3. Kalshi API v2 Credentials (Ed25519 or RSA-PSS Private Key) ---
# KALSHI_ENV: "production" or "demo"
KALSHI_ENV="production"
KALSHI_API_KEY_ID=""
KALSHI_PRIVATE_KEY=""
# Legacy alias env names supported by server credential resolver (leave blank if using above):
KALSHI_API_ID=""
KALSHI_KEY_ID=""
KALSHI_API_KEY=""
KALSHI_SECRET=""

# --- 4. Public.com Brokerage API Credentials ---
PUBLIC_API_TOKEN=""
PUBLIC_SECRET_KEY=""
PUBLIC_ACCOUNT_ID=""

# --- 5. Polymarket CLOB Credentials (Optional) ---
POLYMARKET_API_KEY=""

# --- 6. Execution Mode, Global Kill Switch & Server-Side Capital Allocation Limits ---
# EXECUTION_MODE defaults to "PAPER". Live execution requires BOTH EXECUTION_MODE="LIVE" and ALLOW_LIVE_ORDERS="true".
EXECUTION_MODE="PAPER"
ALLOW_LIVE_ORDERS="false"
GLOBAL_KILL_SWITCH="false"

# Server-side capital allocation caps (validated against live venue cash balances & combined NLV)
MAX_TOTAL_AGENT_ALLOCATION_USD="250"
MAX_KALSHI_AGENT_ALLOCATION_USD="100"
MAX_PUBLIC_AGENT_ALLOCATION_USD="150"
MAX_SINGLE_AGENT_NLV_FRACTION="0.25"

# --- 7. Express API Security & Rate Governance ---
API_REQUEST_SIZE_LIMIT="256kb"
API_RATE_LIMIT_PER_MIN="240"
API_MUTATION_RATE_LIMIT_PER_MIN="45"

# --- 8. Python MCP Server & Local Storage Paths ---
MCP_PORT="8787"
QUANT_LEDGER_DB="quant_ledger.duckdb.sqlite"
KALSHI_BRIER_SQLITE_DB="kalshi_brier_calibration.sqlite"
MAX_DAILY_DRAWDOWN_DOLLARS="50.00"
MAX_NOTIONAL_PER_MARKET="25.00"
MAX_CONTRACTS_PER_ORDER="15"
