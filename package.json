{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx server.ts",
    "start:prod": "node dist/server.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/smoke.test.ts",
    "lint:eslint": "eslint src scripts --max-warnings=999",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
    "git:hygiene": "bash scripts/git-hygiene-untrack.sh",
    "set-admin-claim": "tsx scripts/set-admin-claim.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "d3": "7.9.0",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "express-rate-limit": "8.7.2",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/d3": "7.4.3",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "esbuild": "0.25.12",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1"
  }
}
